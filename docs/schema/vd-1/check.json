{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Check",
  "description": "A check over one observed value. Externally tagged, so `Equals(2)` renders as\n`{\"equals\":2}` and `Satisfies(..)` as `{\"satisfies\":{\"source\":\"..\"}}`.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "equals": true
      },
      "additionalProperties": false,
      "required": [
        "equals"
      ]
    },
    {
      "type": "object",
      "properties": {
        "contains": true
      },
      "additionalProperties": false,
      "required": [
        "contains"
      ]
    },
    {
      "type": "object",
      "properties": {
        "satisfies": {
          "$ref": "#/$defs/SatisfiesSpec"
        }
      },
      "additionalProperties": false,
      "required": [
        "satisfies"
      ]
    }
  ],
  "$defs": {
    "SatisfiesSpec": {
      "description": "A predicate the plugin evaluates. `source` is the predicate text; `accepts` and `rejects`\nare the witness pair the author supplies when static analysis cannot settle bivalence.",
      "type": "object",
      "properties": {
        "accepts": true,
        "rejects": true,
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source"
      ]
    }
  }
}
