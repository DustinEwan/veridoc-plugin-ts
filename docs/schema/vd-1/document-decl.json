{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentDecl",
  "description": "One declared document node, as `index.doc.ts` reports it.",
  "type": "object",
  "properties": {
    "audience": {
      "type": "string"
    },
    "notApplicable": {
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "selects": {
      "$ref": "#/$defs/Selects"
    }
  },
  "additionalProperties": false,
  "required": [
    "path",
    "audience",
    "question",
    "selects"
  ],
  "$defs": {
    "Kind": {
      "description": "The five claim kinds. The distinction the kinds carry is normative against observational.",
      "type": "string",
      "enum": [
        "requires",
        "ensures",
        "invariant",
        "witness",
        "because"
      ]
    },
    "Selects": {
      "description": "A document node's selection. Every present field must match; an all-`None` `Selects`\nselects nothing and is reported rather than treated as \"select everything\".",
      "type": "object",
      "properties": {
        "claims": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "concept": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/Kind"
          }
        },
        "referent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
