{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handshake",
  "description": "The only protocol revision this build speaks, as it appears in a handshake.",
  "type": "object",
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "protocolVersion": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "name",
    "version",
    "languages",
    "capabilities"
  ],
  "$defs": {
    "Capability": {
      "description": "A method family the plugin answers. A missing capability is reported, never silently\ntreated as a pass; the engine's behaviour per absence is fixed by the capability table in\n`docs/spec.md`.",
      "type": "string",
      "enum": [
        "collect",
        "resolution",
        "derivability",
        "bivalence",
        "execution",
        "citation",
        "surface"
      ]
    }
  }
}
