{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefToken",
  "description": "What a claim is about: a resolved symbol or a declared concept. Internally tagged on\n`kind` so the wire shape matches the builder call.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "symbol"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "from"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "concept"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ]
    }
  ]
}
