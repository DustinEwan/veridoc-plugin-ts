{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "description": "A response message, discriminated by the presence of `result` or `error` (spec §4).",
  "anyOf": [
    {
      "$ref": "#/$defs/Success"
    },
    {
      "$ref": "#/$defs/Failure"
    }
  ],
  "$defs": {
    "ErrorObject": {
      "description": "The `error` object of a refusal. A profile that needs more detail than the code and the text\nputs a typed reason in `data` (spec §5).",
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int64"
        },
        "data": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "Failure": {
      "description": "A response whose envelope carries `error`: a refusal. A refusal is an answer, not a loss\n(spec §8).",
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorObject"
        },
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "error"
      ]
    },
    "JsonRpcVersion": {
      "description": "The only JSON-RPC revision this mechanism speaks.",
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "Success": {
      "description": "A response whose envelope carries `result`.",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion"
        },
        "result": true
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    }
  }
}
